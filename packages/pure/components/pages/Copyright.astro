---
import {type CollectionKey, type InferEntrySchema} from 'astro:content'

import config from 'virtual:config'

import {cn, getFormattedDate} from '../../utils'
import {QRCode} from '../advanced'
import {Icon} from '../user'

interface Props<T extends CollectionKey> {
  data: InferEntrySchema<T>
  class?: string
}

const {
  data: { title, publishDate },
  class: className
} = Astro.props
---

<div
  class={cn(
    'relative flex flex-col gap-y-2 rounded-xl border px-3 sm:px-4 py-2 sm:py-3',
    className
  )}
>
  <Icon class='absolute end-4 top-4 size-20 opacity-10' name='copyright' />

  {/* title & link */}
  <div class='flex flex-col'>
    <div class='font-medium text-foreground'>{title}</div>
    <div class='text-sm'>{Astro.url}</div>
  </div>

  {/* common info */}
  <div class='flex flex-row flex-wrap justify-start gap-x-5 gap-y-1 sm:gap-x-8'>
    <div class='flex gap-x-2 sm:flex-col'>
      <span>作者</span>
      <span class='text-sm text-foreground max-sm:place-self-center'>{config.author}</span>
    </div>
    {
      publishDate && (
        <div class='flex gap-x-2 sm:min-w-16 sm:flex-col'>
          <span>发布时间</span>
          <span class='text-sm text-foreground max-sm:place-self-center'>
            {getFormattedDate(publishDate, {
              month: 'long'
            })}
          </span>
        </div>
      )
    }
    <div class='flex gap-x-2 sm:flex-col'>
      <span>许可证</span>
      <a
        class='text-sm text-foreground max-sm:place-self-center'
        href='https://creativecommons.org/licenses/by-sa/4.0/'
        target='_blank'
      >
        CC BY-SA 4.0
      </a>
    </div>
  </div>

  {/* functions */}
  <div class='relative'>
    <div class='flex flex-row gap-3'>
      <button
        id='copy-link'
        aria-label='Copy link'
        class='group rounded-full bg-muted p-1 text-muted-foreground transition-colors hover:text-primary sm:p-1.5'
      >
        <Icon class='size-5' name='link' />
      </button>
      <button
        id='get-qrcode'
        aria-label='Get QR code'
        class='group rounded-full bg-muted p-1 text-muted-foreground transition-colors hover:text-primary sm:p-1.5'
      >
        <Icon class='size-5' name='qrcode' />
      </button>
    </div>
  </div>
</div>

{/* 二维码弹窗：与主题卡片/按钮保持同一套圆角与描边规范 */}
<div
  id='qrcode-modal'
  class='fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm'
  role='dialog'
  aria-modal='true'
  aria-label='文章二维码'
>
  <div class='w-full max-w-xs rounded-xl border bg-background p-4 shadow-lg shadow-black/10'>
    <p class='mb-3 text-center text-sm text-muted-foreground'>扫码在手机上打开本文</p>
    <div class='flex justify-center'>
      <div class='rounded-lg border bg-white p-2.5'>
        <QRCode class='block' />
      </div>
    </div>
    <div class='mt-4 flex gap-2'>
      <button
        id='qrcode-cancel'
        class='flex-1 rounded-lg border bg-muted px-3 py-1.5 text-sm text-muted-foreground transition-all hover:bg-card hover:text-foreground'
      >
        取消
      </button>
      <button
        id='qrcode-download'
        class='flex-1 rounded-lg border bg-muted px-3 py-1.5 text-sm text-foreground transition-all hover:bg-card hover:text-primary'
      >
        下载
      </button>
    </div>
  </div>
</div>

<style>
  /* qrcodejs 动态插入的 canvas 无 Astro scope，需用 :global 命中；img 是隐藏副本不要动 */
  #qrcode-container :global(canvas) {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>

<script>
  import {showToast} from '../../utils'

  // Copy link
  const copyLink = document.getElementById('copy-link')
  copyLink?.addEventListener('click', () => {
    navigator.clipboard.writeText(window.location.href)
    // Show toast
    showToast({ message: 'Link copied!' })
  })

  // QR code dialog
  const modal = document.getElementById('qrcode-modal')
  const openBtn = document.getElementById('get-qrcode')
  const cancelBtn = document.getElementById('qrcode-cancel')
  const downloadBtn = document.getElementById('qrcode-download')
  const qrContainer = document.getElementById('qrcode-container')

  const openModal = () => {
    modal?.classList.remove('hidden')
    modal?.classList.add('flex')
    document.body.style.overflow = 'hidden'
  }

  const closeModal = () => {
    modal?.classList.add('hidden')
    modal?.classList.remove('flex')
    document.body.style.overflow = ''
  }

  openBtn?.addEventListener('click', openModal)
  cancelBtn?.addEventListener('click', closeModal)

  // Click on overlay to close
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal()
  })

  // ESC to close
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal()
  })

  // Download QR code as PNG
  downloadBtn?.addEventListener('click', () => {
    const canvas = qrContainer?.querySelector('canvas')
    const img = qrContainer?.querySelector('img')
    const dataUrl = canvas ? canvas.toDataURL('image/png') : (img?.src ?? '')
    if (!dataUrl) return

    const slug = location.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'home'
    const a = document.createElement('a')
    a.href = dataUrl
    a.download = `${slug}-qrcode.png`
    document.body.appendChild(a)
    a.click()
    document.body.removeChild(a)
  })
</script>
