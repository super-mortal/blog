---
import config from 'virtual:config'
import {footerAuthor, icp} from '../../../../src/site.config'


const footerConf = config.footer

const footerLink1 = footerConf.links?.filter(({ pos }) => pos === 1) || []
---

<footer class='mx-auto mb-5 mt-16 w-full'>
  <div class='border-t pt-5'>
    <div class='flex items-center justify-center gap-y-3 max-sm:flex-col sm:gap-y-0'>
      <div class='flex items-center gap-x-4 gap-y-2 text-muted-foreground max-sm:flex-col'>
        { /* Position 1 */
          footerLink1.length > 0 && (
            <div>
              {footerLink1.map(({ title, link, style }, index) => (
                <>
                  <!-- prettier-ignore -->
                  <a href={link} target='_blank' rel='noopener noreferrer' class={style}>{title}</a>
                  {index < footerLink1.length - 1 && <span class='mx-1'>•</span>}
                </>
              ))}
            </div>
          )
        }
        {
          /* ICP 备案编号：排在最前，与版权信息同排，桌面端单行居中；链接指向工信部备案管理系统（备案办法第十三条） */
          icp.number && (
            <span class='text-sm'>
              <a href={icp.link} target='_blank' rel='noopener noreferrer'>
                {icp.number}
              </a>
            </span>
          )
        }
        {
          /* 公安联网备案：图标显示于编号之前，与 ICP 编号同排；桌面端单行，窄屏随容器自动换行 */
          icp.police && (
            <a
              href={icp.policeLink || 'https://beian.mps.gov.cn/'}
              target='_blank'
              rel='noopener noreferrer'
              class='inline-flex items-center gap-1 text-sm'
            >
              {icp.policeIcon && (
                /* 官方图标为 36×40 竖版比例，固定高度、宽度自适应，避免被拉伸变形 */
                <img src={icp.policeIcon} alt='' aria-hidden='true' class='h-4 w-auto' />
              )}
              {icp.police}
            </a>
          )
        }
        {/* Position 2 */}
        <div>
          {config.footer.year}
          {
            footerAuthor.link ? (
              <a href={footerAuthor.link} target='_blank' rel='noopener noreferrer'>
                {footerAuthor.name}
              </a>
            ) : (
              footerAuthor.name
            )
          }
          {
            footerConf.links && footerConf.links.length > 0 && (
              <>
                &
                <span>
                  {footerConf.links
                    .filter(({ pos }) => pos === 2)
                    .map(({ title, link, style }) => (
                      <span>
                        <a href={link} target='_blank' rel='noopener noreferrer' class={style}>{title}</a>
                      </span>
                    ))}
                </span>
              </>
            )
          }
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    color: hsl(var(--foreground) / var(--un-text-opacity, 1));
    text-decoration: none;
    font-weight: 500;
  }
  
  footer a:hover {
    text-decoration: underline;
  }
</style>
