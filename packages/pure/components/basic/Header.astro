---
import config from 'virtual:config'

import {Icon} from '../user'
---

<header-component
  class='group sticky top-4 z-50 max-md:z-30 mb-12 flex items-center justify-between rounded-xl border border-transparent max-sm:py-1 sm:rounded-2xl'
>
  <a
    class='z-30 text-xl font-medium group-[.not-top]:ms-2 sm:group-[.not-top]:ms-3'
    style='transition:margin-inline 0.3s'
    href='/'
    aria-label='Brand'>{config.title}</a
  >

  <div class='flex items-center gap-x-2'>
    {/* Menu links */}
    <div
      id='headerExpandContent'
      class='end-0 start-0 top-12 grid sm:grid-rows-1 max-sm:absolute max-sm:opacity-0'
    >
      <div
        class='flex flex-col overflow-hidden sm:flex-row sm:items-center sm:justify-center max-sm:rounded-xl max-sm:border max-sm:border-border max-sm:bg-background max-sm:p-1.5'
      >
        {
          config.header.menu.map((item) => (
            <a
              href={item.link}
              class='w-full flex-none grow py-2 text-right font-medium transition-none hover:text-primary sm:w-fit sm:px-3 max-sm:rounded-lg max-sm:px-3 max-sm:py-2.5 max-sm:text-start max-sm:transition-colors max-sm:hover:bg-muted max-sm:hover:text-foreground max-sm:active:bg-muted'
              aria-label='Nav menu item'
            >
              {item.title}
            </a>
          ))
        }
        <div class='flex w-full grow flex-row justify-end gap-x-3 sm:w-fit sm:gap-x-5 max-sm:mt-1 max-sm:justify-start max-sm:border-t max-sm:border-border max-sm:pt-1 max-sm:gap-x-0'>
          <a
            class='px-1 py-2 transition-none sm:px-2 max-sm:flex max-sm:items-center max-sm:gap-x-2 max-sm:rounded-lg max-sm:px-3 max-sm:py-2.5 max-sm:transition-colors max-sm:hover:bg-muted'
            href='/search'
            aria-label='搜索'
          >
            <Icon name='search' class='size-5' />
            <span class='hidden max-sm:inline'>搜索</span>
          </a>
        </div>
      </div>
    </div>

    {/* buttons */}
    <div class='z-30 flex gap-x-4 group-[.not-top]:gap-x-2' style='transition:gap 0.3s'>
      <button
        id='toggleDarkMode'
        class='group/dark box-content size-5 rounded-md border p-1.5 transition-colors hover:bg-border sm:group-[.not-top]:rounded-xl'
      >
        <span class='sr-only'>Dark Theme</span>
        <Icon class='system size-5 group-hover/dark:text-primary' name='computer' />
        <Icon class='light hidden size-5 group-hover/dark:text-primary' name='sun' />
        <Icon class='dark hidden size-5 group-hover/dark:text-primary' name='moon' />
      </button>
      <button
        id='toggleMenu'
        class='rounded-md border p-1.5 transition-colors hover:bg-border sm:hidden sm:group-[.not-top]:rounded-xl'
        aria-expanded='false'
        aria-controls='headerExpandContent'
        aria-label='打开菜单'
      >
        <Icon class='icon-menu size-5' name='menu' />
        <Icon class='icon-close hidden size-5' name='close' />
      </button>
    </div>
  </div>
</header-component>

{/* 移动端菜单遮罩：点击空白处收起 */}
<div
  id='headerBackdrop'
  class='pointer-events-none fixed inset-0 z-20 hidden bg-background/70 opacity-0 backdrop-blur-[2px] transition-opacity duration-200 max-sm:block'
  aria-hidden='true'>
</div>

{/* Use inline to load icon quicker firstly */}
<script is:inline>
  const toggleDarkModeElement = document.getElementById('toggleDarkMode')
  if (toggleDarkModeElement) {
    toggleDarkModeElement.dataset.theme = localStorage.getItem('theme') || 'system'
  }
</script>
<script>
  import {setTheme, showToast} from '../../utils'

  class HeaderComponent extends HTMLElement {
    connectedCallback() {
      // Header
      let preScrollY = window.scrollY
      this.classList.toggle('not-top', preScrollY > 20)
      window.addEventListener('scroll', () => {
        this.classList.toggle('not-top', window.scrollY > 20)
        this.dataset.show = (window.scrollY < 350 || window.scrollY < preScrollY).toString()
        preScrollY = window.scrollY
      })

      // Dark Mode
      const darkModeBtn = this.querySelector('#toggleDarkMode') as HTMLElement
      darkModeBtn.addEventListener('click', () => {
        // Old way: dispatch event
        // const toggleDarkModeEvent = new CustomEvent('theme-change', {
        //   detail: { theme: localStorage.getItem('theme') === 'light' ? 'dark' : 'light' }
        // })
        // document.dispatchEvent(toggleDarkModeEvent)
        const newTheme = setTheme(undefined, true)
        darkModeBtn.dataset.theme = newTheme
        showToast({ message: `Set theme to ${newTheme}` })
      })

      // Menu（移动端下拉菜单）
      const menuBtn = this.querySelector('#toggleMenu') as HTMLElement | null
      const menuPanel = this.querySelector('#headerExpandContent') as HTMLElement | null
      // 遮罩是 header-component 的相邻兄弟节点，需在父级查找
      const backdrop = this.parentElement?.querySelector('#headerBackdrop') as HTMLElement | null

      const setMenu = (open: boolean) => {
        this.classList.toggle('expanded', open)
        menuBtn?.setAttribute('aria-expanded', String(open))
        menuBtn?.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单')
        // 仅在移动端锁滚动，避免遮罩打开时背景跟着滑动
        document.documentElement.classList.toggle('menu-open', open)
      }

      menuBtn?.addEventListener('click', () => {
        setMenu(!this.classList.contains('expanded'))
      })

      // 点击遮罩关闭
      backdrop?.addEventListener('click', () => setMenu(false))

      // 点击菜单内任意链接后自动收起（避免返回时菜单仍展开）
      menuPanel?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenu(false))
      })

      // ESC 关闭 + 切到桌面宽度时关闭
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.classList.contains('expanded')) setMenu(false)
      })
      window.matchMedia('(min-width: 641px)').addEventListener('change', (e) => {
        if (e.matches) setMenu(false)
      })
    }
  }

  customElements.define('header-component', HeaderComponent)
</script>

<style>
  header-component {
    transition:
      padding 0.3s,
      transform 0.3s,
      margin-inline 0.3s,
      border 0.15s,
      background-color 0.15s;

    &.not-top {
      --un-border-opacity: 1;
      border-color: hsl(var(--border) / var(--un-border-opacity));
      --un-bg-opacity: 1;
      background-color: hsl(var(--background) / var(--un-bg-opacity));
      padding-left: 0.375rem;
      padding-right: 0.375rem;
      box-shadow:
        rgb(255, 255, 255) 0px 0px 0px 0px,
        rgba(24, 24, 27, 0.08) 0px 0px 0px 1px,
        rgba(39, 39, 42, 0.08) 0px 10px 15px -3px,
        rgba(39, 39, 42, 0.08) 0px 4px 6px -4px;
    }
    &[data-show='false']:not(.expanded) {
      transform: translateY(-5rem);
    }
  }
  @media (min-width: 800px) {
    header-component.not-top {
      margin-inline: 8%;
    }
  }
  :global(.dark) header-component.not-top {
    background-color: hsl(var(--muted) / var(--un-bg-opacity));
  }

  /* header menu */
  @media (max-width: 640px) {
    #headerExpandContent {
      grid-template-rows: 0fr;
      pointer-events: none;
      /* 收起时置为 hidden：避免残留的 14px 高度仍可被键盘聚焦 */
      visibility: hidden;
      transition:
        opacity 0.2s ease,
        grid-template-rows 0.28s cubic-bezier(0.4, 0, 0.2, 1),
        visibility 0.28s;
    }
    .expanded #headerExpandContent {
      grid-template-rows: 1fr;
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
      transition:
        opacity 0.2s ease,
        grid-template-rows 0.28s cubic-bezier(0.4, 0, 0.2, 1),
        visibility 0s;
    }

    /* 展开时的卡片投影，与 not-top 状态下的头部保持一致 */
    .expanded #headerExpandContent > div {
      box-shadow:
        rgba(24, 24, 27, 0.08) 0px 0px 0px 1px,
        rgba(39, 39, 42, 0.08) 0px 10px 15px -3px,
        rgba(39, 39, 42, 0.08) 0px 4px 6px -4px;
    }

    /* 图标随状态切换：汉堡 ↔ 关闭 */
    .expanded .icon-menu {
      display: none;
    }
    .expanded .icon-close {
      display: block;
    }

    /* 遮罩只在展开时接管点击 */
    .expanded + #headerBackdrop {
      pointer-events: auto;
      opacity: 1;
    }

    /* 菜单打开时锁住背景滚动 */
    :global(html.menu-open) {
      overflow: hidden;
    }
  }

  /* dark light mode toggle */
  #toggleDarkMode {
    &[data-theme='dark'] {
      & .system {
        display: none;
      }
      & .dark {
        display: block;
      }
    }
    &[data-theme='light'] {
      & .system {
        display: none;
      }
      .light {
        display: block;
      }
    }
  }
</style>
